<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="!(loc.ProductName)"
           Language="2052"
           Codepage="936"
           Version="1.0.0.0"
           Manufacturer="!(loc.Manufacturer)"
           UpgradeCode="B8E6A4D2-5C71-4F3A-9D02-1F7C0A6E42B9">

    <Package InstallerVersion="200"
             Compressed="yes"
             InstallScope="perMachine"
             Description="!(loc.ProductDescription)"
             Manufacturer="!(loc.Manufacturer)" />

    <MajorUpgrade DowngradeErrorMessage="!(loc.DowngradeMessage)" />
    <MediaTemplate EmbedCab="yes" />

    <!-- Default install dir: D:\Dingfengbo; app data goes to D:\Data\Dingfengbo -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <Property Id="INSTALLFOLDER" Value="D:\Dingfengbo\" />
    <UIRef Id="WixUI_InstallDir" />
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />

    <Feature Id="ProductFeature" Title="!(loc.FeatureTitle)" Level="1" ConfigurableDirectory="INSTALLFOLDER">
      <ComponentGroupRef Id="DingfengboFiles" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Product>

  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="DesktopFolder" />
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="!(loc.AppFolderName)" />
      </Directory>
      <Directory Id="INSTALLFOLDER" Name="Dingfengbo" />
    </Directory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="DingfengboFiles" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="3F1C9B7A-42E8-4D55-8F1A-6C2E93D7A001">
        <File Id="ExeFile"
              Source="..\dist\!(loc.ExeFileName)"
              Name="!(loc.ExeFileName)"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="3F1C9B7A-42E8-4D55-8F1A-6C2E93D7A002">
      <Shortcut Id="DesktopShortcutLink"
                Name="!(loc.ShortcutName)"
                Target="[INSTALLFOLDER]!(loc.ExeFileName)"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon"
                Advertise="no" />
      <RegistryValue Root="HKCU" Key="Software\Dingfengbo\DesktopShortcut" Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="StartMenuShortcut" Directory="ApplicationProgramsFolder" Guid="3F1C9B7A-42E8-4D55-8F1A-6C2E93D7A003">
      <Shortcut Id="StartMenuShortcutLink"
                Name="!(loc.ShortcutName)"
                Target="[INSTALLFOLDER]!(loc.ExeFileName)"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon" />
      <Shortcut Id="UninstallShortcut"
                Name="!(loc.UninstallShortcutName)"
                Target="[SystemFolder]msiexec.exe"
                Arguments="/x [ProductCode]"
                Icon="AppIcon" />
      <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\Dingfengbo\StartMenu" Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Icon Id="AppIcon" SourceFile="icon.ico" />
  </Fragment>
</Wix>
